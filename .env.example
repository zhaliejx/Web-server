# ── Ajest web app — environment ─────────────────────────────────────────────
# There are NO required secrets. Copy to .env (or set in your host's dashboard)
# and adjust as needed.

# Prisma SQLite database (created automatically on first write).
# Use an absolute path in production, e.g. on Render:
#   DATABASE_URL=file:/opt/render/project/src/db/custom.db
DATABASE_URL=file:./db/custom.db

# OPTIONAL — override the relay-search chain (comma-separated, tried in
# parallel). Defaults already include the public relay nodes; a self-hosted
# web app next to its own fork can skip the dead localhost hop:
#   RELAY_HOSTS=https://api-ajest.onrender.com
# RELAY_HOSTS=
